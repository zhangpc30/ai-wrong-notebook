.result-intro {
  padding: 32rpx;
  background: linear-gradient(180deg, #eaf3ee 0%, #faf8f2 100%);
  border-color: #cfe1d8;
}

.result-title {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.quality-warning {
  margin-top: 22rpx;
  padding: 26rpx;
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 22rpx;
}

.quality-title {
  font-weight: 700;
}

.quality-copy,
.quality-item {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.split-card {
  display: grid;
  grid-template-columns: 76rpx 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 26rpx;
  background: #f2f7f4;
  border: 1rpx solid #cfe1d8;
  border-radius: 22rpx;
}

.split-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  background: #1f6b55;
  border-radius: 22rpx 22rpx 22rpx 7rpx;
}

.split-title {
  color: #174d3e;
  font-weight: 750;
}

.split-copy {
  margin-top: 8rpx;
  color: #557267;
  font-size: 23rpx;
  line-height: 1.5;
}

.split-button {
  grid-column: 1 / -1;
  min-height: 72rpx;
  color: #174d3e;
  font-size: 25rpx;
  background: #fff;
  border: 1rpx solid #bcd5c9;
}

.question-image {
  width: 100%;
  height: 440rpx;
  margin-top: 24rpx;
  background: #e2e8f0;
  border-radius: 24rpx;
}

.large {
  min-height: 240rpx;
}

.answer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.save-button {
  margin-top: 32rpx;
}
