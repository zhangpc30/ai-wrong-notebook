.config-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx 26rpx;
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
}

.config-title {
  font-size: 26rpx;
  font-weight: 680;
}

.config-copy {
  margin-top: 6rpx;
  color: #a16207;
  font-size: 22rpx;
}

.config-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 680;
}

.hero {
  position: relative;
  padding: 42rpx 38rpx 38rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(138deg, #3730a3 0%, #4f46e5 52%, #6366f1 100%);
  border-radius: 30rpx;
  box-shadow: 0 20rpx 44rpx rgba(67, 56, 202, 0.24);
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.hero-title {
  max-width: 580rpx;
  margin-top: 24rpx;
  font-size: 43rpx;
  font-weight: 720;
  line-height: 1.28;
  letter-spacing: -0.8rpx;
}

.hero-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
  line-height: 1.65;
}

.hero-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  color: #4338ca;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(30, 27, 75, 0.16);
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.quick-actions .secondary-button {
  min-height: 76rpx;
  font-size: 25rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid;
  border-radius: 20rpx;
}

.stat-value {
  min-width: 54rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.stat-label {
  margin-left: 16rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.35;
}

.stat-blue {
  color: #2563eb;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.stat-red {
  color: #dc2626;
  background: #fef2f2;
  border-color: #fecaca;
}

.stat-orange {
  color: #ea580c;
  background: #fff7ed;
  border-color: #fed7aa;
}

.stat-green {
  color: #16a34a;
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.insights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 20rpx;
}

.insight {
  min-height: 126rpx;
  padding: 26rpx;
}

.insight-label {
  color: #64748b;
  font-size: 24rpx;
}

.insight-value {
  margin-top: 14rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-heading,
.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title.compact {
  margin-bottom: 20rpx;
}

.link {
  padding: 14rpx 0 14rpx 20rpx;
  color: #4f46e5;
  font-size: 25rpx;
  font-weight: 600;
}

.question-card {
  margin-bottom: 18rpx;
}

.question-meta {
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 650;
}

.question-title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  font-weight: 650;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.question-footer {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 22rpx;
}

.home-empty {
  padding: 56rpx 34rpx;
}

.empty-title {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 680;
}

.empty-copy {
  max-width: 520rpx;
  margin: 14rpx auto 28rpx;
  font-size: 24rpx;
}

.empty-action {
  max-width: 360rpx;
  min-height: 76rpx;
  margin: 0 auto;
  font-size: 25rpx;
}
