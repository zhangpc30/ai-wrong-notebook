.hint,
.privacy {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.current-url {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  overflow-wrap: anywhere;
  color: #475569;
  font-size: 23rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.button-row button {
  min-height: 84rpx;
  font-size: 26rpx;
}

.status {
  margin-top: 20rpx;
  padding: 18rpx;
  color: #4338ca;
  font-size: 24rpx;
  background: #eef2ff;
  border-radius: 14rpx;
}

.data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.data-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.data-count {
  color: #4f46e5;
  font-size: 36rpx;
  font-weight: 800;
}

.clear-button {
  margin-top: 18rpx;
}

.data-card .secondary-button,
.data-card .danger-button {
  min-height: 80rpx;
  font-size: 26rpx;
}
