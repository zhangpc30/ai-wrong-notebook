<view class="page">
  <view class="page-title">拍照录题</view>
  <view class="page-subtitle">一张清晰的题目照片，就能生成完整错题解析。</view>

  <view class="capture-hero">
    <view class="capture-title">录入公考错题</view>
    <view class="capture-copy">拍照后可先裁剪聚焦题目，再提交云端分析；相册图片也支持同样操作。</view>

    <view class="preview" wx:if="{{imagePath}}">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFit" bindtap="previewImage" />
      <view class="image-meta">
        <text>已选择题目图片</text>
        <text wx:if="{{imageSizeText}}">{{imageSizeText}}</text>
      </view>
      <view class="preview-actions">
        <button class="mini-button crop-button" bindtap="cropImage">裁剪聚焦</button>
        <button class="mini-button" bindtap="chooseFromCamera">重新拍照</button>
        <button class="mini-button danger" bindtap="clearImage">移除</button>
      </view>
    </view>
    <view class="source-actions" wx:else>
      <button class="primary-button choose-button" bindtap="chooseFromCamera">拍照录题</button>
      <button class="secondary-button choose-button" bindtap="chooseFromAlbum">从相册选择</button>
    </view>
  </view>

  <view class="section-title">补充信息（可选）</view>
  <view class="card">
    <textarea
      class="textarea"
      value="{{textHint}}"
      maxlength="1000"
      placeholder="例如：我的答案是 A，重点分析为什么会选错。"
      bindinput="onHintInput"
    />
  </view>

  <button class="primary-button analyze-button" bindtap="analyze" disabled="{{loading || !imagePath}}">
    开始 AI 分析
  </button>

  <view class="error-card" wx:if="{{errorMessage}}">
    <view class="error-title">本次分析未完成</view>
    <view class="error-copy">{{errorMessage}}</view>
    <button class="secondary-button retry-button" bindtap="analyze" disabled="{{loading || !imagePath}}">重试分析</button>
  </view>

  <view class="section-title">录题建议</view>
  <view class="card tips">
    <view class="tip">完整保留题干、选项和必要图表。</view>
    <view class="tip">避免反光、阴影和大角度倾斜。</view>
    <view class="tip">分析结果可在下一页逐项修改后保存。</view>
  </view>
</view>

<view class="loading-mask" wx:if="{{loading}}">
  <view class="loading-sheet">
    <view class="loading-mark">{{loadingStep}}</view>
    <view class="loading-title">{{loadingText}}</view>
    <view class="step-track">
      <view class="step {{loadingStep >= 1 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>优化</text>
      </view>
      <view class="step-line {{loadingStep >= 2 ? 'active' : ''}}"></view>
      <view class="step {{loadingStep >= 2 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>上传</text>
      </view>
      <view class="step-line {{loadingStep >= 3 ? 'active' : ''}}"></view>
      <view class="step {{loadingStep >= 3 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text>分析</text>
      </view>
    </view>
    <view class="progress-track" wx:if="{{loadingStep === 2}}">
      <view class="progress-value" style="width: {{uploadProgress}}%;"></view>
    </view>
    <view class="loading-subtitle">任务已在云端处理，复杂题目可能需要一至两分钟</view>
  </view>
</view>
