.hint,
.privacy {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.current-url {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  overflow-wrap: anywhere;
  color: #475569;
  font-size: 23rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 24rpx;
}

.button-row button {
  width: 100%;
  min-width: 0;
  padding-right: 12rpx;
  padding-left: 12rpx;
  min-height: 84rpx;
  font-size: 26rpx;
}

.status {
  margin-top: 20rpx;
  padding: 18rpx;
  color: #174d3e;
  font-size: 24rpx;
  background: #eaf3ee;
  border-radius: 14rpx;
}

.data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.data-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.data-count {
  color: #1f6b55;
  font-size: 36rpx;
  font-weight: 800;
}

.clear-button {
  margin-top: 18rpx;
}

.backup-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  gap: 14rpx;
}

.data-card .secondary-button,
.data-card .danger-button {
  min-height: 80rpx;
  font-size: 26rpx;
}

.backup-actions .secondary-button {
  width: 100%;
  min-width: 0;
  padding: 0 12rpx;
  font-size: 23rpx;
}

.cloud-head,
.cloud-actions {
  display: flex;
  align-items: center;
}

.cloud-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  color: #fff;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 750;
  background: #1f6b55;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}

.cloud-info {
  margin-left: 20rpx;
}

.cloud-title {
  font-weight: 750;
}

.cloud-copy,
.cloud-note {
  margin-top: 7rpx;
  color: #6b756f;
  font-size: 22rpx;
  line-height: 1.55;
}

.cloud-button,
.cloud-actions {
  margin-top: 26rpx;
}

.cloud-actions {
  width: 100%;
  gap: 14rpx;
}

.cloud-actions .primary-button {
  flex: 2;
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
}

.cloud-actions .secondary-button {
  flex: 1;
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
}

.sync-status {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  color: #174d3e;
  font-size: 23rpx;
  line-height: 1.5;
  background: #eaf3ee;
  border-radius: 14rpx;
}

.cloud-note {
  margin-top: 18rpx;
}
