.filter-card {
  padding: 22rpx;
}

.view-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  background: #e8ece8;
  border-radius: 18rpx;
}

.view-tab {
  padding: 16rpx 6rpx;
  color: #68746d;
  font-size: 23rpx;
  text-align: center;
  border-radius: 13rpx;
}

.view-tab.active {
  color: #174d3e;
  font-weight: 750;
  background: #fffdf8;
  box-shadow: 0 4rpx 14rpx rgba(34, 53, 43, 0.08);
}

.search {
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe2ea;
  border-radius: 16rpx;
}

.filter-row,
.question-top,
.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-row {
  margin-top: 18rpx;
  gap: 14rpx;
}

.filter-row picker {
  flex: 1;
  min-width: 0;
}

.filter-picker {
  min-width: 0;
  padding: 17rpx 22rpx;
  text-align: center;
  color: #174d3e;
  font-size: 24rpx;
  background: #eaf3ee;
  border-radius: 14rpx;
}

.clear-filter {
  padding: 16rpx 4rpx 16rpx 20rpx;
  color: #64748b;
  font-size: 24rpx;
}

.filter-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 4rpx;
}

.result-count {
  color: #64748b;
  font-size: 24rpx;
}

.list-toolbar,
.selection-bar,
.selection-actions,
.top-actions,
.question-meta {
  display: flex;
  align-items: center;
}

.list-toolbar {
  justify-content: space-between;
  margin: 24rpx 4rpx 18rpx;
}

.manage-action {
  color: #1f6b55;
  font-size: 24rpx;
  font-weight: 700;
}

.selection-bar {
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  color: #174d3e;
  font-size: 24rpx;
  background: #edf5f1;
  border-radius: 16rpx;
}

.selection-actions {
  gap: 28rpx;
  font-weight: 700;
}

.favorite-action {
  color: #b7791f;
}

.danger-action {
  color: #b7472a;
}

.question-card {
  margin-bottom: 18rpx;
}

.question-meta {
  color: #1f6b55;
  font-size: 24rpx;
  font-weight: 650;
}

.select-dot {
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 2rpx solid #9aa69f;
  border-radius: 50%;
}

.select-dot.selected {
  background: #1f6b55;
  border: 7rpx solid #cfe1d8;
}

.top-actions {
  gap: 12rpx;
}

.favorite {
  padding: 5rpx;
  color: #9aa39d;
  font-size: 34rpx;
  line-height: 1;
}

.favorite.active {
  color: #c4872d;
}

.priority {
  padding: 8rpx 14rpx;
  color: #64748b;
  font-size: 20rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
}

.priority-high {
  color: #a9462d;
  background: #faeee9;
}

.question-title {
  display: -webkit-box;
  margin-top: 18rpx;
  overflow: hidden;
  font-weight: 650;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.knowledge {
  margin-top: 16rpx;
  color: #174d3e;
  font-size: 24rpx;
}

.mistake {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.question-footer {
  margin-top: 22rpx;
  color: #64748b;
  font-size: 22rpx;
}

.delete-item {
  min-height: 62rpx;
  margin-top: 18rpx;
  color: #a9462d;
  font-size: 23rpx;
  background: #faeee9;
  border: 1rpx solid #efd2c8;
}

.empty-title {
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 680;
}

.empty-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
}
