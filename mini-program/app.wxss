page {
  min-height: 100%;
  background: #f4f2ec;
  color: #17211b;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  box-sizing: border-box;
  display: grid;
  place-items: center;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
  padding-right: 24rpx;
  padding-left: 24rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  border-radius: 18rpx;
}

button::after {
  border: 0;
}

.primary-button,
.secondary-button,
.danger-button {
  margin-right: 0;
  margin-left: 0;
  text-align: center;
}

button[disabled] {
  color: rgba(255, 255, 255, 0.72) !important;
  background: #9bb8aa !important;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 30rpx 72rpx;
}

.page-title {
  margin: 2rpx 0 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
}

.page-subtitle {
  margin-bottom: 30rpx;
  color: #6b756f;
  font-size: 25rpx;
  line-height: 1.55;
}

.section-title {
  margin: 38rpx 2rpx 18rpx;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.35;
}

.card {
  box-sizing: border-box;
  padding: 30rpx;
  background: #fffdf8;
  border: 1rpx solid #dedbd2;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(43, 56, 48, 0.055);
}

.primary-button {
  width: 100%;
  min-height: 92rpx;
  color: #ffffff;
  background: #1f6b55;
  box-shadow: 0 12rpx 24rpx rgba(31, 107, 85, 0.18);
}

.secondary-button {
  width: 100%;
  min-height: 84rpx;
  color: #174d3e;
  background: #eaf3ee;
  border: 1rpx solid #cfe1d8;
}

.danger-button {
  width: 100%;
  min-height: 84rpx;
  color: #a9462d;
  background: #faeee9;
  border: 1rpx solid #efd2c8;
}

.muted {
  color: #6b756f;
}

.empty {
  padding: 88rpx 32rpx;
  color: #6b756f;
  line-height: 1.65;
  text-align: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 18rpx;
  color: #174d3e;
  font-size: 24rpx;
  background: #eaf3ee;
  border-radius: 999rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #3c4a42;
  font-size: 25rpx;
  font-weight: 650;
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 24rpx;
  color: #17211b;
  background: #f8f6f0;
  border: 1rpx solid #d8d6cd;
  border-radius: 16rpx;
}

.input,
.picker {
  min-height: 84rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.textarea {
  min-height: 168rpx;
  line-height: 1.55;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e7e3da;
}

.loading-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(21, 34, 28, 0.72);
}

.loading-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.loading-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}
