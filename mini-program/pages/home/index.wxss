.config-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx 26rpx;
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  margin-bottom: 18rpx;
  padding: 0 18rpx;
  color: #68746d;
  font-size: 21rpx;
  font-weight: 700;
  background: #e8ece8;
  border-radius: 999rpx;
}

.mode-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: #8c9891;
  border-radius: 50%;
}

.mode-cloud {
  color: #17533f;
  background: #dfeee6;
}

.mode-cloud .mode-dot {
  background: #1f8a63;
  box-shadow: 0 0 0 6rpx rgba(31, 138, 99, 0.12);
}

.mode-warning {
  color: #8a5b17;
  background: #fbf1d8;
}

.mode-warning .mode-dot {
  background: #c4872d;
}

.config-title {
  font-size: 26rpx;
  font-weight: 680;
}

.config-copy {
  margin-top: 6rpx;
  color: #a16207;
  font-size: 22rpx;
}

.config-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 680;
}

.hero {
  position: relative;
  padding: 42rpx 38rpx 38rpx;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 8%, rgba(220, 150, 102, 0.28), transparent 31%),
    linear-gradient(138deg, #173f34 0%, #1f6b55 58%, #477f69 100%);
  border-radius: 30rpx;
  box-shadow: 0 20rpx 44rpx rgba(24, 63, 52, 0.22);
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.hero-title {
  max-width: 580rpx;
  margin-top: 24rpx;
  font-size: 43rpx;
  font-weight: 720;
  line-height: 1.28;
  letter-spacing: -0.8rpx;
}

.hero-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
  line-height: 1.65;
}

.hero-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  color: #174d3e;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(30, 27, 75, 0.16);
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.quick-actions .secondary-button {
  min-height: 76rpx;
  font-size: 25rpx;
}

.review-quick {
  color: #fff;
  background: #1f6b55;
  border-color: #1f6b55;
}

.review-callout {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
  color: #fff;
  background: #183f34;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(24, 63, 52, 0.16);
}

.review-callout-main {
  flex: 1;
}

.review-eyebrow {
  color: #b9d8ca;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.review-title {
  margin-top: 9rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.review-copy {
  margin-top: 8rpx;
  color: #c9ddd4;
  font-size: 22rpx;
}

.review-arrow {
  margin-left: 20rpx;
  font-family: Georgia, serif;
  font-size: 54rpx;
  font-weight: 300;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid;
  border-radius: 20rpx;
}

.stat-value {
  min-width: 54rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.stat-label {
  margin-left: 16rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.35;
}

.stat-blue {
  color: #2563eb;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.stat-red {
  color: #dc2626;
  background: #faeee9;
  border-color: #fecaca;
}

.stat-orange {
  color: #ea580c;
  background: #fff7ed;
  border-color: #fed7aa;
}

.stat-green {
  color: #16a34a;
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.insights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 20rpx;
}

.progress-card {
  margin-top: 20rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  font-weight: 750;
}

.progress-copy {
  margin-top: 8rpx;
  color: #6b756f;
  font-size: 22rpx;
}

.progress-percent {
  color: #1f6b55;
  font-family: Georgia, serif;
  font-size: 38rpx;
  font-weight: 700;
}

.mastery-track {
  height: 12rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #e6ebe7;
  border-radius: 999rpx;
}

.mastery-value {
  height: 100%;
  min-width: 4rpx;
  background: linear-gradient(90deg, #1f6b55, #5e9a7e);
  border-radius: 999rpx;
}

.insight {
  min-height: 126rpx;
  padding: 26rpx;
}

.insight-label {
  color: #64748b;
  font-size: 24rpx;
}

.insight-value {
  margin-top: 14rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-heading,
.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title.compact {
  margin-bottom: 20rpx;
}

.link {
  padding: 14rpx 0 14rpx 20rpx;
  color: #1f6b55;
  font-size: 25rpx;
  font-weight: 600;
}

.question-card {
  margin-bottom: 18rpx;
}

.question-meta {
  color: #1f6b55;
  font-size: 24rpx;
  font-weight: 650;
}

.question-title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  font-weight: 650;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.question-footer {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 22rpx;
}

.home-empty {
  padding: 56rpx 34rpx;
}

.empty-title {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 680;
}

.empty-copy {
  max-width: 520rpx;
  margin: 14rpx auto 28rpx;
  font-size: 24rpx;
}

.empty-action {
  max-width: 360rpx;
  min-height: 76rpx;
  margin: 0 auto;
  font-size: 25rpx;
}
