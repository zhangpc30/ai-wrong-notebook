.capture-hero {
  padding: 34rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(217, 100, 69, 0.1), transparent 35%),
    linear-gradient(180deg, #eaf3ee 0%, #faf8f2 100%);
  border: 1rpx solid #cfe1d8;
  border-radius: 28rpx;
}

.capture-title {
  font-size: 38rpx;
  font-weight: 750;
}

.capture-copy {
  margin: 14rpx 0 30rpx;
  color: #64748b;
  line-height: 1.6;
}

.choose-button {
  box-shadow: 0 12rpx 24rpx rgba(31, 107, 85, 0.16);
}

.source-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  gap: 18rpx;
}

.source-actions .choose-button {
  width: 100%;
  min-width: 0;
  padding-right: 12rpx;
  padding-left: 12rpx;
  min-height: 84rpx;
  font-size: 26rpx;
}

.preview {
  overflow: hidden;
  background: #ffffff;
  border-radius: 20rpx;
}

.preview-image {
  width: 100%;
  height: 560rpx;
  background: #e2e8f0;
}

.image-meta {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 18rpx 0;
  color: #64748b;
  font-size: 22rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
}

.mini-button {
  flex: 1;
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  color: #174d3e;
  font-size: 25rpx;
  background: #eaf3ee;
}

.mini-button.danger {
  color: #a9462d;
  background: #faeee9;
}

.analyze-button {
  margin-top: 28rpx;
}

.error-card {
  margin-top: 20rpx;
  padding: 24rpx;
  color: #991b1b;
  background: #faeee9;
  border: 1rpx solid #fecaca;
  border-radius: 20rpx;
}

.error-title {
  font-weight: 680;
}

.error-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  min-height: 72rpx;
  margin-top: 20rpx;
  font-size: 25rpx;
}

.tips {
  color: #475569;
  line-height: 1.6;
}

.tip {
  position: relative;
  padding: 10rpx 0 10rpx 28rpx;
}

.tip::before {
  position: absolute;
  top: 27rpx;
  left: 0;
  width: 10rpx;
  height: 10rpx;
  background: #d96445;
  border-radius: 50%;
  content: "";
}

.loading-sheet {
  box-sizing: border-box;
  width: 610rpx;
  padding: 42rpx 38rpx;
  color: #17211b;
  text-align: center;
  background: #fffdf8;
  border-radius: 30rpx;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.22);
}

.loading-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  background: #1f6b55;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}

.step-track {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-top: 34rpx;
}

.step {
  color: #9aa39d;
  font-size: 21rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 auto 10rpx;
  background: #d8ddd9;
  border-radius: 50%;
}

.step.active {
  color: #1f6b55;
}

.step.active .step-dot,
.step-line.active {
  background: #1f6b55;
}

.step-line {
  width: 92rpx;
  height: 4rpx;
  margin: 6rpx 12rpx 0;
  background: #d8ddd9;
}

.progress-track {
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background: #e4e8e5;
  border-radius: 999rpx;
}

.progress-value {
  height: 100%;
  background: #d96445;
  border-radius: 999rpx;
  transition: width 180ms ease;
}

.loading-sheet .loading-subtitle {
  color: #758078;
}
