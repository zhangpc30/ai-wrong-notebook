API_KEY=replace-with-provider-api-key
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o
PORT=8080
TEMPERATURE=0.2
MAX_TOKENS=3000
REQUEST_TIMEOUT_MS=240000
ALLOWED_ORIGINS=*
MAX_REQUESTS_PER_MINUTE=30
MAX_IMAGE_BYTES=20971520
TRUST_PROXY=1
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_DAYS=30
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALLOW_DEV_LOGIN=false
DATA_DIR=/app/data
PUBLIC_BASE_URL=https://ai.example.com
