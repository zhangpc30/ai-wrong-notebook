.capture-hero {
  padding: 34rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f8f9ff 100%);
  border: 1rpx solid #d7ddff;
  border-radius: 28rpx;
}

.capture-title {
  font-size: 38rpx;
  font-weight: 750;
}

.capture-copy {
  margin: 14rpx 0 30rpx;
  color: #64748b;
  line-height: 1.6;
}

.choose-button {
  box-shadow: 0 12rpx 24rpx rgba(79, 70, 229, 0.16);
}

.source-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.source-actions .choose-button {
  min-height: 84rpx;
  font-size: 26rpx;
}

.preview {
  overflow: hidden;
  background: #ffffff;
  border-radius: 20rpx;
}

.preview-image {
  width: 100%;
  height: 560rpx;
  background: #e2e8f0;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
}

.mini-button {
  flex: 1;
  min-height: 72rpx;
  color: #4338ca;
  font-size: 25rpx;
  background: #eef2ff;
}

.mini-button.danger {
  color: #b91c1c;
  background: #fef2f2;
}

.analyze-button {
  margin-top: 28rpx;
}

.error-card {
  margin-top: 20rpx;
  padding: 24rpx;
  color: #991b1b;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 20rpx;
}

.error-title {
  font-weight: 680;
}

.error-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  min-height: 72rpx;
  margin-top: 20rpx;
  font-size: 25rpx;
}

.tips {
  color: #475569;
  line-height: 1.6;
}

.tip {
  position: relative;
  padding: 10rpx 0 10rpx 28rpx;
}

.tip::before {
  position: absolute;
  top: 27rpx;
  left: 0;
  width: 10rpx;
  height: 10rpx;
  background: #6366f1;
  border-radius: 50%;
  content: "";
}
